{
  "name": "@mcpx-digital/csv-tools",
  "version": "0.1.0",
  "description": "MCP server for local CSV validation, schema checks, CSV↔JSON conversion, sampling, and duplicate-key detection. Local files only — never uploads user data.",
  "type": "module",
  "bin": {
    "csv-tools-mcp": "./index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test test/*.test.js"
  },
  "files": [
    "index.js",
    "lib.js",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "csv",
    "json",
    "data",
    "mcpx"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheoryofShadows/csv-tools-mcp.git"
  },
  "homepage": "https://github.com/TheoryofShadows/csv-tools-mcp#readme",
  "author": "TheoryofShadows",
  "bugs": {
    "url": "https://github.com/TheoryofShadows/csv-tools-mcp/issues"
  }
}
